# --- DATABASE -----------------------------------------------------------
#
# Production schema is PostgreSQL. For local development you have 3 options:
#
#   1) Easiest: use a Neon free dev branch.
#      Sign up at https://neon.tech, create a project, copy the pooled
#      connection string here. Same shape as production.
#
#   2) Local Postgres via Docker:
#        docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16
#        DATABASE_URL="postgresql://postgres:dev@localhost:5432/postgres"
#
#   3) Local SQLite (CAUTION: schema is Postgres-only; you'd need to
#      change prisma/schema.prisma `provider = "postgresql"` back to
#      `"sqlite"` AND skip migrations. Only for quick offline poking.)
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- SECRETS ------------------------------------------------------------
# 64-char hex; required for the credentials encryption layer to work.
# Generate with: openssl rand -hex 32
FINOPS_ENCRYPTION_KEY=""

# Optional: lock the /api/log ingest endpoint with a shared bearer secret.
FINOPS_INGEST_TOKEN=""

# Optional: lets server-rendered pages compute absolute fetch URLs
# when behind a reverse proxy or in non-standard hostnames.
# NEXT_PUBLIC_BASE_URL="https://ai-finops.vercel.app"
