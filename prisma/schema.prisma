datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // Force the standard library client (not Accelerate/Data-Proxy).
  // Without this, Prisma 5.x on Vercel sometimes generates a "prisma://"-only
  // client that breaks against a plain postgresql:// URL from Neon.
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model PromptLog {
  id                   String   @id @default(cuid())
  timestamp            DateTime @default(now())
  appName              String?
  userId               String?
  model                String
  provider             String?
  promptText           String
  responseText         String?
  inputTokens          Int
  outputTokens         Int
  totalTokens          Int
  inputCost            Float
  outputCost           Float
  totalCost            Float
  category             String
  complexity           String
  complexityScore      Float
  dimensions           String
  characteristics      String
  latencyMs            Int?
  metadata             String?
  potentialSavedTokens Int      @default(0)
  potentialSavedCost   Float    @default(0)
  // Audit H12: SDK-logged rows are one row per call (callCount = 1).
  // Import-aggregate rows fold many calls into one row — set callCount to
  // the actual request_count from the provider. Stats and insights use
  // sum(callCount) where they previously used count(*).
  callCount            Int      @default(1)
  // Comma-separated user-supplied tags for slicing reports
  // (e.g., "team-marketing,prod,v2"). Free-form, not normalized.
  tags                 String?

  @@index([timestamp])
  @@index([category])
  @@index([complexity])
  @@index([model])
}

model ModelPricingConfig {
  id                  String   @id @default(cuid())
  model               String   @unique
  provider            String?
  inputCostPer1M      Float
  outputCostPer1M     Float
  // Audit C3: cache reads and cache writes are priced differently from
  // standard input. Anthropic ~10% / 125%; OpenAI cached ~50%. When these
  // are null the importer falls back to documented family ratios.
  cacheReadCostPer1M  Float?
  cacheWriteCostPer1M Float?
  contextWindow       Int
  isActive            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model OptimizationLog {
  id              String   @id @default(cuid())
  promptLogId     String?
  originalPrompt  String
  optimizedPrompt String
  originalTokens  Int
  optimizedTokens Int
  savedTokens     Int
  savedCost       Float
  suggestions     String
  createdAt       DateTime @default(now())
}

model Credential {
  id            String   @id @default(cuid())
  provider      String // 'anthropic' | 'openai' | 'google' | 'azure' | 'gateway'
  label         String?
  encryptedBlob String // AES-256-GCM ciphertext, base64
  iv            String // base64
  authTag       String // base64
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, label])
  @@index([provider])
}

model ImportJob {
  id              String    @id @default(cuid())
  provider        String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String // 'pending' | 'running' | 'succeeded' | 'failed'
  recordsImported Int       @default(0)
  errorMessage    String?
  rangeFrom       DateTime?
  rangeTo         DateTime?

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Per-app ingest tokens. The dashboard issues these; SDK callers use one
// per application so different apps can be revoked independently and
// last-used timestamps can be tracked.
//
// `hashedKey` stores a SHA-256 hash of the raw token; we never store the
// raw value. The token is shown ONCE at creation and never recoverable.
model ApiKey {
  id         String    @id @default(cuid())
  label      String
  hashedKey  String    @unique
  prefix     String // first 8 chars of raw token, shown for identification
  scopeApps  String? // JSON array of app names; null = any app
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdBy  String? // free-form, e.g. email or username

  @@index([isActive])
  @@index([lastUsedAt])
}

// User-supplied annotations on individual prompts. Lets the team mark
// items as investigated, optimized, or won't-fix, with notes.
model PromptAnnotation {
  id          String   @id @default(cuid())
  promptLogId String
  status      String // 'open' | 'investigating' | 'optimized' | 'wont-fix'
  note        String? // free-form
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String? // free-form

  @@index([promptLogId])
  @@index([status])
}

// Pinned moment-in-time copy of the insights output. Lets users
// compare "this month vs last month" or capture a baseline before
// applying a recommendation campaign.
model InsightsSnapshot {
  id          String   @id @default(cuid())
  label       String
  note        String?
  period      String // '24h' | '7d' | '30d' | 'all'
  capturedAt  DateTime @default(now())
  // Full InsightsResponse object as JSON string. We snapshot it raw
  // rather than re-derive, so the data is immutable even if the
  // underlying logs evolve.
  payloadJson String
  capturedBy  String? // free-form

  @@index([capturedAt])
  @@index([period])
}

// Audit trail of every mutating dashboard action. Append-only.
//
// `action` enum strings: 'budget.create' | 'budget.update' | 'budget.delete'
//   | 'credential.create' | 'credential.delete'
//   | 'anomaly.resolve' | 'anomaly.create'
//   | 'allocation.create' | 'allocation.update' | 'allocation.delete'
//   | 'apikey.create' | 'apikey.revoke' | 'apikey.update'
//   | 'pricing.update'
//   | 'demo.seed' | 'demo.clear'
//   | 'import.run'
//   | 'annotation.upsert' | 'annotation.delete'
//   | 'snapshot.capture' | 'snapshot.delete'
//   | 'auth.login' | 'auth.logout' | 'auth.failed'
model AuditLogEntry {
  id        String   @id @default(cuid())
  actor     String? // free-form (email, IP, "api-key:<id>", "cron", etc.)
  action    String
  // What was acted on — e.g. budget id, credential id, anomaly id.
  targetId  String?
  // What kind of thing — 'budget' | 'credential' | etc.
  targetKind String?
  // JSON snapshot of the before/after, or the full request body. Capped at 8KB.
  payload   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetKind, targetId])
}

// Connected Slack workspace. One row per workspace that installed the
// AI FinOps Slack app via OAuth. Stores tokens for slash-command +
// event handling.
model SlackInstallation {
  id                String   @id @default(cuid())
  teamId            String   @unique
  teamName          String?
  // Bot user OAuth token (xoxb-...). Encrypted at rest using the same
  // FINOPS_ENCRYPTION_KEY scheme as Credential.
  accessTokenBlob   String
  accessTokenIv     String
  accessTokenTag    String
  botUserId         String
  appId             String?
  authedUserId      String?
  defaultChannelId  String?
  installedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)

  @@index([isActive])
}

// Rules that re-allocate shared / multi-team LLM costs to specific
// teams or apps. Example: 30% of `shared-llm-pool` cost goes to
// marketing, 50% to engineering, 20% to support.
//
// `sourceMatcher` JSON: { appName?: string | string[], model?: string }
// `targetSplit` JSON: { [appName: string]: number }  // percents, must sum ~= 100
model AllocationRule {
  id            String   @id @default(cuid())
  name          String
  sourceMatcher String // JSON
  targetSplit   String // JSON
  isActive      Boolean  @default(true)
  priority      Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, priority])
}

// Persistent record of detected anomalies so the system doesn't re-alert
// for the same condition, and operators have a history they can review.
//
// kind: 'cost-spike' | 'new-model' | 'expensive-prompt' | 'budget-breach' | 'latency-spike'
// severity: 'info' | 'warn' | 'critical'
model AnomalyEvent {
  id          String    @id @default(cuid())
  kind        String
  severity    String
  title       String
  description String
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  // JSON. Includes whatever context the detection logic captured —
  // affected app/model/promptLogId, comparison baseline, etc.
  metadata    String?
  // True once a webhook has been dispatched for this event.
  webhookSent Boolean   @default(false)
  // For deduplication: same kind + scopeKey within a 24h window is a
  // duplicate. Used to suppress re-alerts.
  scopeKey    String?

  @@index([detectedAt])
  @@index([severity])
  @@index([kind, scopeKey])
}

// Spend control. One row per scope.
//   scope = 'global'           → enterprise-wide monthly cap
//   scope = 'app'              → cap for a specific appName
//   scope = 'user'             → cap for a specific userId
model Budget {
  id           String   @id @default(cuid())
  scope        String // 'global' | 'app' | 'user'
  scopeValue   String? // null for global; appName / userId otherwise
  monthlyLimit Float
  currency     String   @default("USD")
  alertAt75    Boolean  @default(true)
  alertAt90    Boolean  @default(true)
  alertAt100   Boolean  @default(true)
  webhookUrl   String? // optional Slack / Teams webhook for budget alerts
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, scopeValue])
  @@index([scope])
  @@index([isActive])
}
