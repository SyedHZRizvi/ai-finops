# Copy to .env.production and fill in real values before deploying.

# --- Required ---
# 64-char hex. Generate with: openssl rand -hex 32
FINOPS_ENCRYPTION_KEY=""

# Random secret. Apps that POST to /api/log must send this as Bearer.
# Generate with: openssl rand -hex 32
FINOPS_INGEST_TOKEN=""

# --- Database ---
# SQLite (Docker/Fly/Render with persistent disk):
DATABASE_URL="file:/data/ai-finops.db"

# Postgres (Vercel / serverless — uncomment and set, then change
# `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma):
# DATABASE_URL="postgresql://user:pass@host:5432/finops?sslmode=require"

# --- Optional ---
# Set when running behind a public URL so server components fetch correctly.
NEXT_PUBLIC_BASE_URL="https://ai-finops.your-domain.com"
